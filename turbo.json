{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "dist/**"
            ],
            "env": [
                "MONGODB_URI",
                "CORS_ORIGINS",
                "NODE_ENV",
                "API_PORT",
                "LOG_LEVEL"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^build"
            ]
        }
    }
}