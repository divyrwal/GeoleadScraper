{
  "manifest_version": 3,
  "name": "GeoLead",
  "version": "6.0",
  "description": "Professional business data extraction from Google Maps",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "http://localhost:4000/*",
    "https://photon.komoot.io/*"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_icon": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://maps.google.com/*"
      ],
      "js": [
        "content/selectors.js",
        "content/utils.js",
        "content/dom.js",
        "content/scroller.js",
        "content/navigator.js",
        "content/extractors.js",
        "content/scraper.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}